diff --git c/tests/probe_stubs.h w/tests/probe_stubs.h
new file mode 100644
index 0000000000000000000000000000000000000000..8e547c51d7a0c734df98bed50d3fae90afa89ef4
--- /dev/null
+++ w/tests/probe_stubs.h
@@ -0,0 +1,21 @@
+/* Tests of runtime modules do not load a game image through probe.c. */
+#ifndef CTR_TEST_PROBE_STUBS_H
+#define CTR_TEST_PROBE_STUBS_H
+#include "runtime.h"
+#include <assert.h>
+
+uintptr_t runtime_probe_image(uint64_t *size) {
+    if (size) *size=0;
+    return 0;
+}
+void runtime_probe_read_image(uintptr_t address, void *data, uint64_t size) {
+    (void)address; (void)data; (void)size;
+    assert(!"network test must not read a guest image");
+}
+int runtime_probe_write_image(uintptr_t address, const void *data, uint64_t size) {
+    (void)address; (void)data; (void)size;
+    assert(!"network test must not write a guest image");
+    return 0;
+}
+
+#endif
